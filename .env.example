# Copy to .env.local for local dev. On Vercel, add these under Settings → Environment Variables.

# Kindle's launch factory on Robinhood Chain — deploy it at /factory, then paste the address here and redeploy
NEXT_PUBLIC_KINDLE_FACTORY=

# $KINDLE token — leave empty until launch
NEXT_PUBLIC_KINDLE_CA=
# NEXT_PUBLIC_KINDLE_BUY_URL=
# NEXT_PUBLIC_KINDLE_SYMBOL=KINDLE

# Optional
# ROBINHOOD_RPC_URL=
# GRADUATE_MCAP_USD=69000
